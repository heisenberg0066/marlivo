{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@marlivo/engine": ["packages/engine/src/index.ts"],
      "@marlivo/bots": ["packages/bots/src/index.ts"],
      "@marlivo/room": ["packages/room/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "apps/client/src", "scripts/*.ts"]
}
